# Copy this to .env and fill in real values. Never commit the real .env file.

DB_PASSWORD=changeme_use_a_long_random_string

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme_use_a_long_random_string

# Generate with the password Deshonda will actually type into the admin login:
#   node -e "console.log(require('bcryptjs').hashSync('herRealPassword', 10))"
ADMIN_PASSWORD_HASH=$2a$10$replace_with_generated_hash

# Comma-separated list of domains allowed to call the API
ALLOWED_ORIGIN=https://designsbydeshonda.wisdomignited.com
