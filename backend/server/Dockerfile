FROM node:20-slim

# sharp needs these for image processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev
COPY . .

RUN mkdir -p /app/uploads
EXPOSE 4000
CMD ["node", "index.js"]
