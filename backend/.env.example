# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres password (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
DB_PASSWORD=

# JWT signing secret — same command as above, use a DIFFERENT random value
JWT_SECRET=

# bcrypt hash of DeShonda's real admin password:
# node -e "console.log(require('bcryptjs').hashSync('herRealPassword', 10))"
ADMIN_PASSWORD_HASH=

# Where the frontend is served from, e.g. https://deshondadesigns.store
ALLOWED_ORIGIN=https://deshondadesigns.store
FRONTEND_URL=https://deshondadesigns.store

# Stripe (test mode keys start with sk_test_/whsec_ — switch to live keys
# only once you've tested a full purchase end-to-end)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
